PORT=4000
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/job_application_tracker
JWT_SECRET=replace_with_a_long_random_string

# Email (Resend - https://resend.com)
RESEND_API_KEY=re_your_resend_api_key
# Optional: defaults to Resend's shared test sender if unset
RESEND_FROM=Job Application Tracker <onboarding@resend.dev>
# Used to build links inside emails
FRONTEND_URL=http://localhost:5173

# Shared secret for the manual POST /reminders/send-now trigger
CRON_SECRET=replace_with_a_long_random_string
